# 复制为 .env 后填写。未填写的 Key 会自动进入“模拟模式”，方便本地开发。

# 阿里云百炼（通义千问）API Key：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen-vl-max
QWEN_TEXT_MODEL=qwen-plus

# 腾讯位置服务 Key：https://lbs.qq.com/ （需开通 JavaScript API GL 与 WebService API）
TMAP_KEY=

# 管理后台密码（务必修改）
ADMIN_PASSWORD=change-me

# 服务端口
PORT=8787
